# DocFlow 운영 Caddy 설정 예시.
#
# 동작:
#   - HTTPS 자동 발급 (Let's Encrypt) — Caddy default.
#   - /api/*    → backend Go API (api:8080)
#   - /         → React SPA (정적 파일) + history fallback
#   - HSTS + gzip + access log (JSON, 5년 보관)
#
# 사용:
#   cp infra/caddy-prod.example.Caddyfile /etc/caddy/Caddyfile
#   sed -i 's/docflow.example.com/실제도메인/g' /etc/caddy/Caddyfile
#   systemctl reload caddy
#
# 또는 docker compose 사용 시:
#   docker-compose.prod.yml 의 caddy service 가 본 파일을 /etc/caddy/Caddyfile 로 mount.

{
    # 글로벌 옵션 — admin endpoint 는 localhost 만 (보안).
    admin localhost:2019
    # ACME email — 인증서 만료 알람.
    email ops@example.com
}

docflow.example.com {
    encode gzip zstd

    # HSTS — 2년, preload.
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # CSP 는 운영 단계에서 점진 강화 (P1 은 inline-safe 로 시작).
        Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
    }

    # API: Go backend 로 forward (/api/* prefix 유지).
    handle_path /api/* {
        reverse_proxy api:8080 {
            # health check (Caddy 가 unhealthy upstream 자동 차단).
            health_uri /api/healthz
            health_interval 10s
            health_timeout 3s
            # client IP 전달 (audit log).
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # SPA: 정적 파일 + history fallback (vite build 결과물).
    handle {
        root * /srv/docflow
        try_files {path} /index.html
        file_server
    }

    # 액세스 로그 — JSON, host 마운트, 5년 보관 (logrotate 별도).
    log {
        output file /var/log/caddy/docflow.log {
            roll_size 100mb
            roll_keep 60        # 5년 가량 (월 1회 round)
            roll_keep_for 1825d # 5년 (CLAUDE.md §3.8 보관 정책)
        }
        format json
    }
}

# HTTP → HTTPS 자동 redirect 는 Caddy default — 별도 명시 불필요.
